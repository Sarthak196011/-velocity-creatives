# ========================================================
# Velocity Creatives - Optional Environment Variables
# ========================================================
# Note: The system works out of the box with automated fallbacks!
# Add your real credentials below in .env.local to send live emails & Zoom links.

# --------------------------------------------------------
# 1. OPTIONAL: Real Email Dispatch (Gmail or Custom SMTP)
# --------------------------------------------------------
# Option A: Send via your Gmail account (Generate App Password at: https://myaccount.google.com/apppasswords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASS=your-16-char-app-password

# Option B: Send via Custom SMTP (Hostinger, AWS SES, SendGrid, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Velocity Creatives <hello@yourdomain.com>"

# --------------------------------------------------------
# 2. OPTIONAL: Official Zoom API Integration
# --------------------------------------------------------
# (Get from Zoom Marketplace -> Server-to-Server OAuth App)
# If left blank, the app generates unique secure Zoom room URLs automatically!
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
